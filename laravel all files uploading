    public function filesFormStore(Request $request){
    
                $fields=['file','file2'];
                $multipleFiles=[];
                $multipleSizes = [];
                $multipleExts = [];

    foreach($fields as $field){
        $files=$request->file($field);
        if($files){
            $fileName=now()->timestamp . uniqid() .'.png';
            $multipleFiles[$field] = $fileName;
            $multipleSizes[$field] = $files->getSize();
            $files->move(public_path('images'),$fileName);
            $multipleExts[$field] = $files->getClientOriginalExtension();
            
        } else {
            // If no file uploaded, set null
            $multipleFiles[$field] = null;
            $multipleSizes[$field] = null;
            $multipleExts[$field] = null;
        }
    }
    MyFiles::create([
        // 'name' => $request->name,
        'file' => $multipleFiles['file'],
        'name' => $multipleFiles['file2'],
        'file_size' => $multipleSizes['file'] . ',' . $multipleSizes['file2'],
        'file_ext' => $multipleExts['file'] . ',' . $multipleExts['file2'],
    ]);

    return back()->with('success', 'File uploaded successfully!');
    }
